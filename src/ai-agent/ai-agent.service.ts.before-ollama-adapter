import { Injectable } from '@nestjs/common';

import { CompaniesService } from '../companies/companies.service';
import { ChatRequestDto } from './dto/chat-request.dto';
import { AiChatSessionsService } from './services/ai-chat-sessions.service';
import type {
  AiChatMessage,
  AiChatMessageRole,
} from './types/chat-message.type';

type CompanyView = {
  id: string;
  name: string;
  level: string;
  country: string;
  city: string;
  foundedYear: number | null;
  annualRevenue: number;
  employees: number;
  profitEfficiency: number;
};

@Injectable()
export class AiAgentService {
  constructor(
    private readonly companiesService: CompaniesService,
    private readonly sessionsService: AiChatSessionsService,
  ) {}

  async chat(request: ChatRequestDto) {
    const session = request.sessionId
      ? await this.sessionsService.findOne(request.sessionId)
      : await this.sessionsService.create(
          this.createSessionTitle(request.message),
        );

    const companies = await this.companiesService.findAll();
    const query = request.message.trim().toLowerCase();

    const userMessage = this.createTextMessage(
      'user',
      request.message.trim(),
    );

    const assistantMessages =
      this.createReplyMessages(companies, query);

    await this.sessionsService.appendMessages(
      session.id,
      [
        userMessage,
        ...assistantMessages,
      ],
    );

    return {
      sessionId: session.id,
      messages: assistantMessages,
    };
  }

  private createReplyMessages(
    companies: CompanyView[],
    query: string,
  ): AiChatMessage[] {
    if (
      this.includesAny(query, [
        'level',
        '等级',
        '级别',
        '层级',
      ])
    ) {
      return [
        this.createDistributionChart(
          companies,
          'level',
          'Companies by level',
        ),
      ];
    }

    if (
      this.includesAny(query, [
        'country',
        'countries',
        '国家',
        '地域',
        '地区分布',
      ])
    ) {
      return [
        this.createDistributionChart(
          companies,
          'country',
          'Companies by country',
        ),
      ];
    }

    if (
      this.includesAny(query, [
        'revenue',
        'income',
        '营收',
        '收入',
        '盈利',
      ])
    ) {
      return [
        this.createCompanyTable(
          companies,
          'revenue',
          'Top companies by annual revenue',
        ),
      ];
    }

    if (
      this.includesAny(query, [
        'employee',
        'employees',
        'staff',
        '员工',
        '雇员',
      ])
    ) {
      return [
        this.createCompanyTable(
          companies,
          'employees',
          'Top companies by employee count',
        ),
      ];
    }

    if (
      this.includesAny(query, [
        'list companies',
        'company list',
        '列出',
        '公司列表',
        '有哪些公司',
        '查看公司',
      ])
    ) {
      return [
        this.createCompanyTable(
          companies,
          'name',
          'Company list',
        ),
      ];
    }

    if (
      this.includesAny(query, [
        'how many',
        'total companies',
        'company count',
        '多少公司',
        '公司数量',
        '公司总数',
      ])
    ) {
      return [
        this.createTextMessage(
          'assistant',
          `There are currently **${companies.length} companies** in the database.`,
        ),
      ];
    }

    const countries = new Set(
      companies
        .map((company) => company.country?.trim())
        .filter(Boolean),
    );

    const levels = new Set(
      companies
        .map((company) => company.level?.trim())
        .filter(Boolean),
    );

    return [
      this.createTextMessage(
        'assistant',
        [
          `The database currently contains **${companies.length} companies** across **${countries.size} countries** and **${levels.size} levels**.`,
          '',
          'You can ask me to:',
          '',
          '- Show the number of companies',
          '- Compare company levels',
          '- Show the country distribution',
          '- Rank companies by annual revenue',
          '- Rank companies by employee count',
          '- List companies',
        ].join('\n'),
      ),
    ];
  }

  private createTextMessage(
    role: AiChatMessageRole,
    markdown: string,
  ): AiChatMessage {
    return {
      id: this.createMessageId(),
      role,
      type: 'text',
      createdAt: new Date().toISOString(),
      content: {
        markdown,
      },
    };
  }

  private createDistributionChart(
    companies: CompanyView[],
    dimension: 'level' | 'country',
    title: string,
  ): AiChatMessage {
    const counts = new Map<string, number>();

    companies.forEach((company) => {
      const value = String(company[dimension] ?? '').trim();
      const label = value || 'Unknown';

      counts.set(label, (counts.get(label) ?? 0) + 1);
    });

    const data = Array.from(counts.entries())
      .map(([label, count]) => ({
        label,
        count,
      }))
      .sort(
        (first, second) =>
          second.count - first.count ||
          first.label.localeCompare(second.label),
      );

    return {
      id: this.createMessageId(),
      role: 'assistant',
      type: 'chart',
      createdAt: new Date().toISOString(),
      content: {
        title,
        chartType: 'bar',
        data,
        xKey: 'label',
        yKeys: ['count'],
      },
    };
  }

  private createCompanyTable(
    companies: CompanyView[],
    sortBy: 'name' | 'revenue' | 'employees',
    title: string,
  ): AiChatMessage {
    const sortedCompanies = [...companies].sort(
      (first, second) => {
        if (sortBy === 'revenue') {
          return (
            second.annualRevenue - first.annualRevenue ||
            first.name.localeCompare(second.name)
          );
        }

        if (sortBy === 'employees') {
          return (
            second.employees - first.employees ||
            first.name.localeCompare(second.name)
          );
        }

        return first.name.localeCompare(second.name);
      },
    );

    return {
      id: this.createMessageId(),
      role: 'assistant',
      type: 'table',
      createdAt: new Date().toISOString(),
      content: {
        title,
        columns: [
          { key: 'name', label: 'Company' },
          { key: 'level', label: 'Level' },
          { key: 'country', label: 'Country' },
          { key: 'city', label: 'City' },
          { key: 'annualRevenue', label: 'Annual Revenue' },
          { key: 'employees', label: 'Employees' },
        ],
        rows: sortedCompanies.slice(0, 20).map((company) => ({
          name: company.name || 'Unnamed company',
          level: company.level || 'Unknown',
          country: company.country || 'Unknown',
          city: company.city || 'Unknown',
          annualRevenue: this.formatCurrency(
            company.annualRevenue,
          ),
          employees: company.employees,
        })),
      },
    };
  }

  private includesAny(query: string, keywords: string[]) {
    return keywords.some((keyword) => query.includes(keyword));
  }

  private createSessionTitle(message: string) {
    return (
      message
        .trim()
        .replace(/\s+/g, ' ')
        .slice(0, 60) ||
      'New conversation'
    );
  }

  private createMessageId() {
    return (
      'message-' +
      Date.now() +
      '-' +
      Math.random().toString(36).slice(2)
    );
  }

  private formatCurrency(value: number) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    }).format(value);
  }
}
