DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=supply_chain_tracker

JWT_SECRET=dev_jwt_secret_change_later
AI_DEFAULT_TENANT_ID=default

# AI cache. If Redis is temporarily unavailable, the module falls back to
# process memory so chat remains usable; production should keep Redis enabled.
AI_REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
AI_SESSION_CACHE_TTL_SECONDS=7200
AI_CHAT_CACHE_ENABLED=true
AI_CHAT_CACHE_TTL_SECONDS=600
AI_CHAT_CACHE_DIMENSION_TTLS={"companies":600}
AI_TASK_STATE_TTL_SECONDS=86400

# Start with mock while testing the chat/session flow.
AI_MODEL_PROVIDER=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-plus

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
